---
type Props = {
  href: string;
};

const { href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="appearance-none flex w-full items-center outline outline-offset-6 outline-white/10 justify-center border hover:border-purple-700 py-6 px-8 bg-neutral-900 text-white font-semibold rounded-md shadow-md focus:ring-2 focus:ring-purple-400 focus:ring-opacity-75"
>
  <slot />
</a>
